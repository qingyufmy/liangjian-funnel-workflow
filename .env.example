# Copy to .env for local use. Process environment values take precedence.
HITHINK_FINANCE_API_KEY=
LIANGJIAN_MODEL_API_KEY=

ASTOCK_HITHINK_BASE_URL=https://fuyao.aicubes.cn
LIANGJIAN_CNINFO_BASE_URL=https://www.cninfo.com.cn
LIANGJIAN_GOV_POLICY_BASE_URL=https://sousuo.www.gov.cn
LIANGJIAN_MODEL_BASE_URL=https://ai-api.finpoints.tech/v1
LIANGJIAN_TIMEZONE=Asia/Shanghai
LIANGJIAN_HTTP_TIMEOUT_SECONDS=30
LIANGJIAN_MODEL_TIMEOUT_SECONDS=600
# Primary/fallback output budgets in tokens. The legacy primary env name is
# retained for compatibility with existing deployments.
LIANGJIAN_MODEL_MAX_OUTPUT_TOKENS=393216
LIANGJIAN_MODEL_FALLBACK_OUTPUT_TOKENS=262144
LIANGJIAN_MODEL_SECONDARY_FALLBACK_OUTPUT_TOKENS=131072
# Maximum input prompt budget in tokens; research.py enforces its estimate.
LIANGJIAN_MODEL_MAX_INPUT_TOKENS=1000000
ASTOCK_HITHINK_MIN_REQUEST_INTERVAL_SECONDS=0.5
LIANGJIAN_CNINFO_MIN_REQUEST_INTERVAL_SECONDS=0.5
# Bounded network workers; the CNINFO client applies the interval globally.
LIANGJIAN_CNINFO_WORKERS=4
LIANGJIAN_CNINFO_PDF_WORKERS=2
LIANGJIAN_CNINFO_PDF_MAX_DOCUMENTS_PER_SYMBOL=3
LIANGJIAN_CNINFO_PDF_RETAIN_RAW=false
LIANGJIAN_GOV_POLICY_MIN_REQUEST_INTERVAL_SECONDS=0.5
MOOTDX_SERVERS=117.34.114.13:7709,110.41.147.114:7709,8.129.13.54:7709,120.24.149.49:7709
MOOTDX_TIMEOUT_SECONDS=10
MOOTDX_PAGE_SIZE=800
MOOTDX_MAX_PAGES=20
MOOTDX_HISTORY_5M_REQUIRED_BARS=12240
LIANGJIAN_MINUTE_CACHE_DIR=
LIANGJIAN_OUTPUT_DIR=
LIANGJIAN_WORKFLOW_OUTPUT_DIR=
LIANGJIAN_SNAPSHOT_DIR=
LIANGJIAN_FACT_STORE_DIR=
LIANGJIAN_OPEN_MACRO_CACHE_DIR=
LIANGJIAN_FACT_CACHE_DB_PATH=
LIANGJIAN_FEATURE_STORE_DB_PATH=
LIANGJIAN_CNINFO_PDF_CACHE_DIR=
LIANGJIAN_STATE_DB_PATH=
LIANGJIAN_WORKFLOW_PROGRESS_PATH=
LIANGJIAN_RESEARCH_CHECKPOINT_DIR=
LIANGJIAN_PROMPT_DIR=
LIANGJIAN_SOURCE_CONFIG_PATH=
LIANGJIAN_NEWS_SOURCE_CONFIG_PATH=
LIANGJIAN_OPEN_NEWS_TIMEOUT_SECONDS=15
LIANGJIAN_OPEN_NEWS_RSS_WORKERS=16
LIANGJIAN_OPEN_NEWS_STOCK_LIMIT=20
LIANGJIAN_OPEN_NEWS_FLASH_LIMIT=50
# Official/open monthly macro + four-asset ETF normalization. Failures degrade
# to a cached/explicitly unavailable contract; they never inject zero values.
LIANGJIAN_OPEN_MACRO_ENABLED=true
LIANGJIAN_A1_BATCH_SIZE=20
LIANGJIAN_A2_BATCH_SIZE=40
LIANGJIAN_RESEARCH_BATCH_WORKERS=2
# V2 evaluates the complete G0 universe locally and sends only ranked node
# candidates to the research models. Set legacy only for temporary rollback.
LIANGJIAN_RESEARCH_PIPELINE_MODE=deterministic_v2
LIANGJIAN_A1_LOCAL_TOP_N_PER_NODE=15
LIANGJIAN_A1_LLM_TOP_N_PER_NODE=3
LIANGJIAN_A1_LLM_REPRESENTATIVES_PER_THEME=8
LIANGJIAN_A1_POLICY_LOOKBACK_DAYS=120
LIANGJIAN_A1_POLICY_DOCUMENT_LIMIT=60
LIANGJIAN_A2_LLM_TOP_N_PER_THEME=8
LIANGJIAN_RESEARCH_CLOSE_DEADLINE_SECONDS=5400
LIANGJIAN_DATA_SYNC_BATCH_SIZE=50
LIANGJIAN_DATA_PROGRESS_EVERY=25
LIANGJIAN_FUNDAMENTAL_REFRESH_HOURS=24
LIANGJIAN_DAILY_REFRESH_HOURS=4
LIANGJIAN_SIMULATION_INITIAL_CASH=1000000
# Role-specific model transport capabilities: research on, intraday monitor off.
LIANGJIAN_RESEARCH_THINKING_ENABLED=true
LIANGJIAN_MONITOR_THINKING_ENABLED=false

# Node control plane / BaoTa. Bind localhost and expose it through Nginx.
NODE_ENV=production
HOST=127.0.0.1
PORT=3210
TZ=Asia/Shanghai
LIANGJIAN_PYTHON_BIN=.venv/bin/python
LIANGJIAN_WEB_DIST=dist/web
LIANGJIAN_SCHEDULER_ENABLED=true
# Mark RUNNING progress as disconnected after 15 minutes without file updates.
LIANGJIAN_WORKFLOW_PROGRESS_STALE_MS=900000
# Optional but recommended. Generate a long random value in BaoTa; never commit it.
LIANGJIAN_DASHBOARD_TOKEN=
