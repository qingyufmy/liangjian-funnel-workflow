[Unit]
Description=One-time 2026-10-12 shadow-only preopen inputs

[Service]
Type=oneshot
User=__SHADOW_USER__
WorkingDirectory=__CHECKOUT_ROOT__
EnvironmentFile=__SHADOW_ENV_FILE__
ExecStart=__PYTHON_BIN__ -B __CHECKOUT_ROOT__/scripts/run_shadow_preopen_sidecar.py --state-db ${SHADOW_STATE_DB} --fact-db ${SHADOW_FACT_DB} --preopen-inputs-db ${PREOPEN_INPUTS_DB} --receipt-json ${PREOPEN_RECEIPT} --target-trade-date 2026-10-12 --lane ${SHADOW_LANE}
RuntimeMaxSec=15min
TimeoutStopSec=10
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=__PRODUCTION_STATE_DIR__ __FACT_CACHE_DIR__
ReadWritePaths=__INDEPENDENT_PREOPEN_DIR__
RestrictAddressFamilies=AF_UNIX

# Template only. The original CLI enforces generation before 09:00.
# Unique receipt path must not already exist; no production plan is modified.
