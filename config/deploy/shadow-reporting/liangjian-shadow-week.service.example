[Unit]
Description=Independent five-explicit-session A4 shadow weekly report

[Service]
Type=oneshot
User=__SHADOW_USER__
WorkingDirectory=__CHECKOUT_ROOT__
EnvironmentFile=__SHADOW_ENV_FILE__
ExecStart=__PYTHON_BIN__ -B __CHECKOUT_ROOT__/scripts/run_shadow_reporting.py --state-db ${SHADOW_STATE_DB} --shadow-db ${SHADOW_LEDGER_DB} --lane ${SHADOW_LANE} --approved-output-root ${SHADOW_A5_APPROVED_ROOT} --node-log-root ${SHADOW_NODE_LOG_ROOT} --archive-root ${SHADOW_REPORT_ARCHIVE} --report-root ${SHADOW_REPORT_DOCS} --bridge-outbox ${SHADOW_BRIDGE_OUTBOX} --week-session ${SHADOW_SESSION_1} --week-session ${SHADOW_SESSION_2} --week-session ${SHADOW_SESSION_3} --week-session ${SHADOW_SESSION_4} --week-session ${SHADOW_SESSION_5}
TimeoutStartSec=5min
TimeoutStopSec=10
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=__PRODUCTION_STATE_DIR__ __PRODUCTION_A5_DIR__ __PRODUCTION_NODE_DIR__
ReadWritePaths=__SHADOW_ARCHIVE_DIR__ __SHADOW_DOCS_DIR__ __SHADOW_OUTBOX_DIR__
RestrictAddressFamilies=AF_UNIX
