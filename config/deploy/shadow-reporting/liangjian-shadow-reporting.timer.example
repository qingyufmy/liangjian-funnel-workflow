[Unit]
Description=Shadow 15:30 draft/observer and 16:45 recovery only

[Timer]
OnCalendar=Mon..Fri *-*-* 15:30:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 16:45:00 Asia/Shanghai
AccuracySec=1s
Persistent=false
Unit=liangjian-shadow-reporting.service

[Install]
WantedBy=timers.target
# Exchange holiday gating is in CLI, not a weekday trading-day assumption.
